 "subs": [
  {
   "start": 0.4,
   "end": 3.9,
   "text": "那天早上，我開始看得見一些數字。",
   "id": "n1",
   "speaker": "her",
   "ko": "그날 아침부터, 숫자가 보이기 시작했다.",
   "en": "That morning, I started seeing numbers.",
   "vo_at": 0.5
  },
  {
   "start": 5.4,
   "end": 8.8,
   "text": "浮在每一個人的頭上。",
   "id": "n2",
   "speaker": "her",
   "ko": "모든 사람의 머리 위에.",
   "en": "Floating above everyone's head.",
   "vo_at": 5.3
  },
  {
   "start": 10.0,
   "end": 13.9,
   "text": "後來我才知道——\n那是我們還能見面的次數。",
   "id": "n3",
   "speaker": "her",
   "ko": "나중에야 알았다—\n우리가 앞으로 만날 수 있는 횟수라는 걸.",
   "en": "Only later did I realize—\nit was how many more times we'd get to meet.",
   "ko_tts": "나중에야 알았다. 우리가 앞으로 만날 수 있는 횟수라는 걸.",
   "rate": "+4%",
   "vo_at": 9.4
  },
  {
   "start": 15.8,
   "end": 18.6,
   "text": "欸！放學要不要一起回家？",
   "id": "f1",
   "speaker": "friend",
   "ko": "야! 끝나고 같이 집에 갈래?",
   "en": "Hey! Wanna walk home together after school?",
   "vo_at": 15.8
  },
  {
   "start": 21.8,
   "end": 23.4,
   "text": "……好。",
   "id": "h1",
   "speaker": "her",
   "ko": "……응.",
   "en": "…Okay.",
   "ko_tts": "응.",
   "vo_at": 22.0
  },
  {
   "start": 24.7,
   "end": 26.0,
   "text": "抱、抱歉——",
   "id": "h2",
   "speaker": "her",
   "ko": "죄, 죄송해요—",
   "en": "S-sorry—",
   "ko_tts": "죄, 죄송해요.",
   "vo_at": 24.6
  },
  {
   "start": 26.4,
   "end": 27.4,
   "text": "沒事。",
   "id": "b1",
   "speaker": "him",
   "ko": "괜찮아요.",
   "en": "It's okay.",
   "vo_at": 26.15
  },
  {
   "start": 27.9,
   "end": 29.2,
   "text": "我們……見過嗎？",
   "id": "b2",
   "speaker": "him",
   "ko": "우리… 본 적 있나요?",
   "en": "Have we… met before?",
   "ko_tts": "우리, 본 적 있나요?",
   "vo_at": 27.08
  }
 ],
